{
  "name": "sealantern-connect",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/SeaLantern-Studio/SeaLantern-Connect",
  "type": "module",
  "scripts": {
    "dev": "vite -c src/vite.config.ts",
    "build": "vue-tsc -p src/tsconfig.json --noEmit && vite build -c src/vite.config.ts",
    "preview": "vite preview -c src/vite.config.ts",
    "test": "vitest run -c src/vite.config.ts",
    "tauri": "tauri",
    "lint": "oxlint -c src/.oxlintrc.json src",
    "lint:fix": "oxlint -c src/.oxlintrc.json --fix src",
    "fmt": "oxfmt -c src/.oxfmtrc.json src package.json pnpm-workspace.yaml README.md",
    "fmt:check": "oxfmt -c src/.oxfmtrc.json --check src package.json pnpm-workspace.yaml README.md"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "cmzya-modern-ui": "^0.5.5",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
