{
  "name": "sealantern-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src/vite.config.ts",
    "build": "vue-tsc --project src/tsconfig.json --noEmit && vite build --config src/vite.config.ts",
    "preview": "vite preview --config src/vite.config.ts",
    "tauri": "tauri",
    "lint": "oxlint --config src/.oxlintrc.json src",
    "lint:fix": "oxlint --config src/.oxlintrc.json --fix src",
    "fmt": "oxfmt --config src/.oxfmtrc.json src package.json pnpm-workspace.yaml README.md",
    "fmt:check": "oxfmt --config src/.oxfmtrc.json --check src package.json pnpm-workspace.yaml README.md"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
