# 启动开发模式
dev():
    pnpm tauri dev

# 构建应用
build() & ci:
    pnpm tauri build

# 格式化并检查前端
_front_check():
    pnpm fmt
    pnpm lint
    pnpm build

# 格式化并检查后端
_back_check():
    cargo fmt --all
    cargo check --all-targets
    cargo clippy --all-targets -- -D warnings

# 执行全部检查
check() & _front_check & _back_check:
    echo "格式化和检查完成"

# 运行测试
test() ? @has("cargo-nextest"):
    cargo nextest run

test():
    cargo test

# 运行本地 CI
ci() & check & test:
    echo "本地 CI 成功"

# 清理构建产物
clean():
    rm -rf node_modules dist
    cargo clean
