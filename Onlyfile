# 启动开发模式
dev(level="info") ? @os("windows") shell?=pwsh:
    $env:SL_LOG = "{{ level }}"; pnpm tauri dev

dev(level="info"):
    SL_LOG={{ level }} pnpm tauri dev

# 构建应用
build() ? @os("macos"):
    pnpm tauri build
    bash scripts/makedmg.sh

build():
    pnpm tauri build

# 格式化并检查前端
_front_check():
    pnpm fmt
    pnpm lint
    pnpm build

# 格式化并检查后端
_back_check():
    cargo fmt --all
    cargo check --all-targets
    cargo clippy --all-targets -- -D warnings

# 执行全部检查
check() & _front_check & _back_check:
    echo "格式化和检查完成"

# 运行测试
test() ? @has("cargo-nextest"):
    pnpm test
    cargo nextest run

test():
    pnpm test
    cargo test --all-targets --workspace

# 运行本地 CI
ci() & check & test:
    echo "本地 CI 成功"

# 清理构建产物
clean():
    rm -rf node_modules dist
    echo "前端已清除"
    cargo clean
    echo "后端已清除"

# 查看项目版本号
show():
    pnpm sv

# 更新版本号并推送
publish(version):
    pnpm cv {{ version }}
    only ci
    git commit -am "chore: 升级到 {{ version }}"
    git tag {{ version }}
    git push --atomic origin HEAD {{ version }}
