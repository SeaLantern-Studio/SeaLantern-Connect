{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeaLantern Connect",
  "version": "0.7.0",
  "identifier": "com.sealantern.connect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SeaLantern Connect",
        "width": 1200,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 625,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 SeaLantern-Studio",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sculk"
        ]
      }
    }
  }
}
